{
  "name": "tarotqa-web",
  "version": "2.9",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ci": "vitest run --reporter=dot",
    "test:coverage": "vitest run --coverage",
    "test:regression": "node scripts/regression-reporter.js",
    "coverage:check": "node scripts/coverage-check.js",
    "validate": "pnpm run lint && pnpm run lint:css && pnpm run coverage:check && pnpm run build",
    "pre-commit": "node scripts/check-api-key-leaks.js && pnpm run lint && pnpm run lint:css && pnpm run test:run && pnpm run coverage:check",
    "preview": "vitest run && vite preview",
    "lint": "eslint src --ext js,jsx",
    "lint:fix": "eslint src --ext js,jsx --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "axios": "^1.16.1",
    "dayjs": "^1.11.20",
    "dompurify": "^3.4.5",
    "html2canvas": "^1.4.1",
    "iztro": "^2.5.8",
    "markdown-it": "^14.1.1",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-multimd-table": "^4.2.3",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-iztro": "^1.4.2",
    "react-router-dom": "^6.30.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/rollup-linux-x64-gnu": "^4.60.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^29.1.1",
    "stylelint": "^16.26.1",
    "stylelint-config-recess-order": "^5.1.1",
    "stylelint-config-standard": "^36.0.1",
    "vite": "^5.4.21",
    "vitest": "^1.6.1"
  }
}
